# Allowlist: ignore everything, then un-ignore exactly what is published.
# Nothing can be committed by accident — not the 116 MB .apkg, not the
# working notes.

*
!.gitignore

# --- docs & licence ---
!README.md
!LICENSE
!LIEPA_AUDIO_LICENCE.md
!requirements.txt
!requirements-dev.txt
!build_single.sh

# --- AnkiWeb listing ---
!ankiweb/
!ankiweb/*.md

# --- site (GitHub Pages) ---
!docs/
!docs/**

# --- pipeline ---
!scripts/
!scripts/*.py
!tests/
!tests/*.py

# --- deck source ---
!data/
!data/*.tsv
!data/*.txt
!data/*.json
!data/*.css
!data/*.md
!data/batches/
!data/batches/*.tsv
!data/cache/
!data/cache/kaikki/
!data/cache/kaikki/*.jsonl
!data/cache/wikt/
!data/cache/wikt/*.html
!data/audio/
!data/audio/*.mp3
!data/audio/.text_manifest.json

# --- project config & CI ---
!pyproject.toml
!.github/
!.github/**
!.claude/
!.claude/skills/
!.claude/skills/**
